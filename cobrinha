on:
  schedule:
    - cron: "0 0 * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  gerar:
    runs-on: ubuntu-latest

    steps:
      - name: Gerar animação
        uses: Platane/snk@v3
        with:
          github_user_name: jonathanosmar
          outputs: |
            dist/github-contribution-grid-snake.svg?palette=github-dark&color_snake=#BB86FC&color_dots=#161020,#3B1D59,#7136A8,#A855F7,#E9D5FF

      - name: Publicar animação
        uses: crazy-max/ghaction-github-pages@v3.1.0
        with:
          target_branch: output
          build_dir: dist
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
